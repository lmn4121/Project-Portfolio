# Digital Twin API — copy to .env and fill values (never commit .env)
OPENAI_API_KEY=

# Optional Pushover lead / unknown-question alerts
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Comma-separated browser origins allowed to call this API
PORTFOLIO_ORIGINS=http://localhost:3000,https://YOUR-VERCEL-DOMAIN.vercel.app

# Optional shared secret (send as X-Twin-Secret from a trusted proxy only;
# leave empty when the browser calls the API directly)
TWIN_API_SECRET=

# Optional overrides
# TWIN_MODEL=gpt-5.4-mini
# TWIN_RATE_LIMIT_PER_MIN=20
# PORT=8000
